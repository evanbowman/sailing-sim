build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /Users/evanbowman/gba/skyland/build && /opt/homebrew/Cellar/cmake/3.28.1/bin/ccmake -S/Users/evanbowman/gba/skyland/build -B/Users/evanbowman/gba/skyland/build
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


